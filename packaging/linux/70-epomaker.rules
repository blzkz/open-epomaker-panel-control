# Lets the logged-in user open the configuration interface of EPOMAKER / RongYuan
# keyboards (USB vendor 0x3151) without root.
# Install: sudo cp 70-epomaker.rules /etc/udev/rules.d/ && sudo udevadm control --reload && sudo udevadm trigger
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3151", MODE="0660", TAG+="uaccess"
