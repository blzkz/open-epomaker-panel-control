# Maintainer: blzkz
pkgname=open-epomaker-panel
pkgver=0.3.0
pkgrel=1
pkgdesc="Open-source control panel for EPOMAKER keyboards (TH80 family)"
arch=('x86_64')
url="https://github.com/blzkz/open-epomaker-panel-control"
license=('MIT')
depends=('gcc-libs' 'glibc' 'systemd-libs' 'libxkbcommon' 'libglvnd' 'hicolor-icon-theme')
optdepends=('libpulse: music-follow effects (parec)'
            'wayland: Wayland sessions'
            'libx11: X11 sessions'
            'libxcursor: X11 sessions'
            'libxrandr: X11 sessions'
            'libxi: X11 sessions')
makedepends=('cargo')
options=('!lto' '!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

_srcdir() { echo "$srcdir/open-epomaker-panel-control-$pkgver"; }

prepare() {
  cd "$(_srcdir)"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$(_srcdir)"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --frozen --release -p epomaker-cli -p epomaker-gui -p epomaker-agent
}

check() {
  cd "$(_srcdir)"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen -p epomaker-core
}

package() {
  cd "$(_srcdir)"
  install -Dm755 target/release/epomaker-panel "$pkgdir/usr/bin/epomaker-panel"
  install -Dm755 target/release/epomaker "$pkgdir/usr/bin/epomaker"
  install -Dm755 target/release/epomaker-agent "$pkgdir/usr/bin/epomaker-agent"
  install -Dm644 packaging/linux/70-epomaker.rules "$pkgdir/usr/lib/udev/rules.d/70-epomaker.rules"
  install -Dm644 packaging/linux/open-epomaker-panel.desktop "$pkgdir/usr/share/applications/open-epomaker-panel.desktop"
  install -Dm644 packaging/linux/open-epomaker-agent.desktop "$pkgdir/usr/share/applications/open-epomaker-agent.desktop"
  install -Dm644 packaging/icons/open-epomaker-panel.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/open-epomaker-panel.svg"
  install -Dm644 packaging/icons/open-epomaker-panel.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/open-epomaker-panel.png"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  target/release/epomaker completions bash | install -Dm644 /dev/stdin "$pkgdir/usr/share/bash-completion/completions/epomaker"
  target/release/epomaker completions zsh | install -Dm644 /dev/stdin "$pkgdir/usr/share/zsh/site-functions/_epomaker"
  target/release/epomaker completions fish | install -Dm644 /dev/stdin "$pkgdir/usr/share/fish/vendor_completions.d/epomaker.fish"
}
